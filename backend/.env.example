# Telegram Bot
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# Telegram Mini App
MINI_APP_URL=https://your-mini-app.vercel.app

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ice_rating_bot
REDIS_URL=redis://localhost:6379

# TON Blockchain
TON_API_KEY=your_ton_api_key
TON_NETWORK=testnet
TON_CENTER_API_KEY=your_toncenter_key

# API
API_PORT=3000
API_URL=http://localhost:3000

# Security
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret

# Environment
NODE_ENV=development

# NFT Collections (comma-separated addresses)
WHITELISTED_COLLECTIONS=EQD...,EQA...

# IceGang Chat
ICEGANG_CHAT_ID=-1001234567890
ICEGANG_BOOST_MULTIPLIER=1.2

# Jobs
NFT_SCAN_INTERVAL_HOURS=6
LEADERBOARD_UPDATE_INTERVAL_MINUTES=5

# Logging
LOG_LEVEL=info
