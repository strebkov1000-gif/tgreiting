{
  "name": "ice-rating-bot-backend",
  "version": "1.0.0",
  "description": "Ice Rating Bot - Backend (Grammy Bot + API)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx src/database/prisma/seed.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": ["telegram", "bot", "ton", "nft", "leaderboard"],
  "author": "Ice Creators",
  "license": "MIT",
  "dependencies": {
    "grammy": "^1.21.1",
    "@grammyjs/conversations": "^1.2.0",
    "@grammyjs/runner": "^2.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.4.1",
    "@prisma/client": "^5.9.1",
    "ioredis": "^5.3.2",
    "@ton/ton": "^13.11.2",
    "@ton/crypto": "^3.2.0",
    "@ton/core": "^0.56.0",
    "axios": "^1.6.7",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "nanoid": "^5.0.5",
    "date-fns": "^3.3.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "prisma": "^5.9.1",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11"
  }
}
